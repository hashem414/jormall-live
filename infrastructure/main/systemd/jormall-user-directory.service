[Unit]
Description=JorMall internal user directory
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=jormall-sso
Group=jormall-sso
EnvironmentFile=/etc/jormall/sso/directory.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /opt/jormall/sso/user_directory.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/jormall/sso
RestrictAddressFamilies=AF_INET AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
