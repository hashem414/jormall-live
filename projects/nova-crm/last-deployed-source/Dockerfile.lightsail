FROM node:22-bookworm-slim

WORKDIR /app
ENV PORT=8080

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

ENV NODE_ENV=production
EXPOSE 8080
CMD ["sh", "-c", "exec npx wrangler dev --config dist/server/wrangler.json --ip 0.0.0.0 --port 8080 --local --persist-to /data --var \"NOVA_MANAGER_EMAIL:$NOVA_MANAGER_EMAIL\" --var \"NOVA_MANAGER_NAME:$NOVA_MANAGER_NAME\" --var \"NOVA_MANAGER_PASSWORD:$NOVA_MANAGER_PASSWORD\" --var \"OPENAI_API_KEY:$OPENAI_API_KEY\" --var \"OPENAI_MODEL:${OPENAI_MODEL:-gpt-5.6-terra}\" --log-level warn"]
